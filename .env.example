NEXTPFM_API_BASE_URL=http://127.0.0.1:10106
NEXTPFM_ENABLE_MOCK_API=false
NEXTPFM_SESSION_SECRET=replace-with-at-least-32-random-characters
NEXTPFM_AUTH_SECURE_COOKIE=false
NEXTPFM_OIDC_ISSUER=http://localhost:8080/realms/nextpfm-dev
NEXTPFM_OIDC_TOKEN_URL=http://127.0.0.1:8080/realms/nextpfm-dev/protocol/openid-connect/token
NEXTPFM_OIDC_LOGOUT_URL=http://127.0.0.1:8080/realms/nextpfm-dev/protocol/openid-connect/logout
NEXTPFM_OIDC_CLIENT_ID=nextpfm-api
# Set only when using a confidential OIDC client.
NEXTPFM_OIDC_CLIENT_SECRET=
